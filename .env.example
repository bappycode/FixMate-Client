# Copy this file to .env.local and fill in the values. Never commit .env.local.

# MongoDB connection string. Include the database name, e.g. .../fixmate
MONGODB_URI=

# Better Auth
# Public URL of this Next.js app (use the production URL on Vercel)
BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Express API base URL (the Server repo)
NEXT_PUBLIC_API_URL=http://localhost:5000
